# Optional values; startup reads the process environment, not this file.
# Export values in your shell. Keep keys in memory, never in a checked-in file.
DATA_DIR=./data
PRICING_STARTUP_MODE=preview
COMMERCE_URL=http://127.0.0.1:8001
# GATEWAY_URL=https://your-company-gateway.example/v1
# GATEWAY_PORT=443
# LLM_MODEL_ANALYST=your-gateway-alias
# LLM_MODEL_STRATEGIST=your-gateway-alias
# LLM_MODEL_ROUTER=your-gateway-alias
# LLM_MODEL_NARRATOR=your-gateway-alias
LLM_TIMEOUT_SECONDS=60
LLM_TRANSPORT_RETRIES=2
# Estimates for aliases without published pricing, USD per million tokens:
LLM_INPUT_COST_PER_MILLION=0.10
LLM_OUTPUT_COST_PER_MILLION=0.40
# Optional LiteLLM pricing IDs when a corporate gateway alias hides the provider model:
# LLM_PRICING_MODEL_ANALYST=gemini/gemini-2.5-flash
# LLM_PRICING_MODEL_STRATEGIST=gemini/gemini-2.5-pro
# LLM_PRICING_MODEL_ROUTER=gemini/gemini-2.5-flash-lite
# LLM_PRICING_MODEL_NARRATOR=gemini/gemini-2.5-flash-lite
# Metadata-only tracing is explicitly opt-in. Export credentials in process memory.
LANGFUSE_ENABLED=false
# LANGFUSE_HOST=https://your-tracing-service.example
# Optional aggregate JSON competitor feed; off unless explicitly enabled:
LIVE_COMPETITOR_ENABLED=false
# LIVE_COMPETITOR_URL=https://your-feed.example/quotes
ALLOW_INSECURE_TLS=false
# Preferred corporate TLS configuration:
# SSL_CERT_FILE=/path/to/corporate-ca.pem
# REQUESTS_CA_BUNDLE=/path/to/corporate-ca.pem

# T14 local knowledge retrieval (no model download happens at app startup):
RAG_EMBEDDING_PROVIDER=local
# RAG_MODEL_CACHE_DIR=./data/models
RAG_CHUNK_SIZE=700
RAG_CHUNK_OVERLAP=100
RAG_ROUTER_TOP_K=1
RAG_NARRATOR_TOP_K=2
RAG_ANALYST_TOP_K=3
RAG_STRATEGIST_TOP_K=4
# Gateway embeddings are opt-in, never an automatic fallback:
ALLOW_GATEWAY_EMBEDDINGS=false
# RAG_GATEWAY_EMBEDDING_MODEL=your-embedding-alias
# RAG_GATEWAY_EMBEDDING_DIMENSIONS=384
